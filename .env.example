# Token bot dari @BotFather (WAJIB diisi pada environment / GitHub Secrets)
TELEGRAM_BOT_TOKEN=ISI_TOKEN_BOT_TELEGRAM_ANDA

# Opsional: daftar Telegram User ID dipisah koma (kosongkan agar publik)
# Contoh: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# Duraasi window polling per eksekusi GitHub Actions (detik, default 210)
RUNNER_POLL_SECONDS=210
